{
  "expo": {
    "name": "tidyloop-fresh",
    "slug": "tidyloop-fresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tidyloopfresh",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.siliconchase.tidyloopfresh"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.siliconchase.tidyloopfresh"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Tidyloop needs access to your photo library to scan for duplicates and clutter.",
          "savePhotosPermission": "Tidyloop needs permission to update your photo library when you clean up items."
        }
      ],
      "react-native-compressor",
      "expo-background-task",
      "expo-task-manager"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
